@startuml Activity_Guru_Pengajuan_Izin
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam activity {
    BackgroundColor #EBF5FB
    BorderColor #2980B9
    FontColor #1B2631
    FontSize 11
}

skinparam diamond {
    BackgroundColor #FEF9E7
    BorderColor #B7950B
    FontColor #7D6608
    FontSize 10
}

|Guru|
start
:Pilih menu "Pengajuan";
:Pilih kategori pengajuan "Izin, Sakit, Cuti";
:Isi form kelengkapan pengajuan;
:Klik tombol "Kirim Pengajuan";

|Sistem|
:Validasi kelengkapan form input;
if (Kelengkapan Form Sesuai?) then (Ya)
    :Simpan data ke tabel pengajuan;
    |Guru|
    :Tampilkan notifikasi pengajuan terkirim ("Status Pending");
    stop
else (Tidak)
    |Sistem|
    :Kirim pesan validasi;
    |Guru|
    :Tampilkan pesan kesalahan input;
    stop
endif
@enduml
