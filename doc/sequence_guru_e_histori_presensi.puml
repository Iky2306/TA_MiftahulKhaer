@startuml Sequence_Guru_Histori_Presensi
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam sequence {
    ArrowColor #2980B9
    ActorBorderColor #1B4F72
    LifeLineBorderColor #2980B9
    LifeLineBackgroundColor #EBF5FB
    ParticipantBorderColor #1B4F72
    ParticipantBackgroundColor #EBF5FB
    ParticipantFontColor #1B2631
    GroupBorderColor #B7950B
    GroupBackgroundColor #FEF9E7
}

actor "Guru" as Guru
boundary "Halaman Histori Presensi\n(presensi/histori.blade.php)" as View
control "PresensiController" as Ctrl
entity "Model Presensi\n(presensi)" as Model
control "PDFGenerator\n(DomPDF)" as PDF

title **SEQUENCE DIAGRAM - HISTORI PRESENSI DAN DOWNLOAD REKAP**

activate Guru
Guru -> View : 1: Pilih menu "Histori"
activate View
View --> Guru : 2: Tampilkan form filter bulan/tahun

Guru -> View : 3: Pilih filter bulan/tahun, klik "Cari/Tampilkan"
View -> Ctrl : 4: getHistoriPresensi(bulan, tahun)
activate Ctrl

Ctrl -> Model : 5: Ambil data presensi guru (WHERE nik & bulan & tahun)
activate Model
Model --> Ctrl : 6: Return data presensi harian
deactivate Model

Ctrl --> View : 7: Return view riwayat presensi
deactivate Ctrl
View --> Guru : 8: Tampilkan daftar riwayat presensi harian

alt #EAFAF1 ya (Download PDF)
    Guru -> View : 9: Klik tombol "Download PDF"
    View -> Ctrl : 10: cetakRekapPresensi(bulan, tahun)
    activate Ctrl

    Ctrl -> PDF : 11: Generate dokumen PDF rekapitulasi presensi
    activate PDF
    PDF --> Ctrl : 12: Return berkas PDF
    deactivate PDF

    Ctrl --> View : 13: Kirim file PDF ke perangkat guru
    deactivate Ctrl
    View --> Guru : 14: Unduh dan simpan dokumen rekap presensi PDF
else #FDEDEC tidak (Selesai Melihat)
    Guru -> View : 15: Selesai melihat riwayat presensi
end

deactivate View
deactivate Guru
@enduml
