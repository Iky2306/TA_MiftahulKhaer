@startuml Class_Diagram_Staff_TU
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 10
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 50
skinparam ranksep 45

skinparam class {
    BackgroundColor #FDFEFE
    BorderColor #1B4F72
    HeaderBackgroundColor #2471A3
    HeaderFontColor white
    FontColor #1B2631
    AttributeFontColor #1B2631
    FontSize 10
    BorderThickness 1.5
}

skinparam class<<Controller>> {
    HeaderBackgroundColor #1B4F72
    BackgroundColor #EBF5FB
}

skinparam class<<Boundary>> {
    HeaderBackgroundColor #6C3483
    BackgroundColor #F4ECF7
}

skinparam arrow {
    Color #1B4F72
    FontColor #1B4F72
    FontSize 9
}

title **CLASS DIAGRAM – ROLE STAFF TU**\n**Sistem Presensi, E-Jurnal & Penggajian Guru**

' === BOUNDARY ===

class HalamanLoginStaff <<Boundary>> {
    + formEmail : TextField
    + formPassword : PasswordField
    --
    + tampilkanFormLogin() : View
    + submitLogin() : Void
}

' === CONTROLLER ===

class AuthController <<Controller>> {
    - guardAdmin : String
    --
    + prosesLoginAdmin(email, password) : Redirect
    + prosesLogoutAdmin() : Redirect
}

class DashboardController <<Controller>> {
    --
    + dashboardAdmin() : View
}

class LaporanPresensiController <<Controller>> {
    - filterBulan : Integer
    - filterTahun : Integer
    --
    + laporan() : View
    + cetakLaporan(dari, sampai) : View
    + laporanJurnal() : View
    + cetakLaporanJurnal(bulan, tahun) : View
    + rekap() : View
    + cetakRekap(bulan, tahun) : View
    + rekapAbsensiGuru(bulan, tahun) : View
    + downloadRekapAbsensiGuru() : File
}

class PayrollController <<Controller>> {
    - periodeBulan : Integer
    - periodeTahun : Integer
    --
    + setingGajiGuru() : View
    + simpanSetingGajiGuru(dataGaji) : Redirect
    + dataGuru(filter) : View
    + storeGuru(dataGuru) : Redirect
    + editGuru(id) : View
    + updateGuru(id, dataGuru) : Redirect
    + deleteGuru(id) : Redirect
    + rekapGajiGuru(bulan, tahun) : View
    + cetakRekapGajiGuru(bulan, tahun) : View
    + cetakSlip(nik, bulan) : View
    + downloadPdf(nik, bulan) : File
    + downloadExcel(bulan, tahun) : File
}

class PengabdianController <<Controller>> {
    --
    + pengabdianData(filter) : View
    + pengabdianStore(dataPengabdian) : Redirect
    + pengabdianEdit(id) : View
    + pengabdianUpdate(id, dataPengabdian) : Redirect
    + pengabdianDelete(id) : Redirect
    + rekapPengabdian(bulan, tahun) : View
    + cetakPengabdian(bulan, tahun) : View
    + pdfPengabdian(bulan, tahun) : File
    + slipgajiPengabdian(nik, bulan) : View
    + excelPengabdian(bulan, tahun) : File
}

' === ENTITY / MODEL ===

class Admins <<Entity>> {
    + id : BigInteger
    + kode_dept : Char(3)
    + kode_cabang : Char(3)
    + name : String
    + email : String
    - password : String
    + remember_token : String
    --
    + getDetailStaf() : Admins
    + gantiPassword(oldPwd, newPwd) : Boolean
    + hasRole(role) : Boolean
}

class Karyawan <<Entity>> {
    + nik : Char(18)
    + nama_lengkap : String
    + jabatan : String
    + kode_dept : Char(3)
    + kode_cabang : Char(3)
    --
    + getDaftarGuru() : Collection
}

class Presensi <<Entity>> {
    + id : Integer
    + nik : Char(18)
    + kode_jam_kerja : Char(4)
    + tgl_presensi : Date
    + jam_in : Time
    + jam_out : Time
    + status : Char(1)
    --
    + getRekapPresensi() : Collection
    + getRekapBulanan(nik, bulan) : Collection
}

class Guru <<Entity>> {
    + id : BigInteger
    + karyawan_nik : Char(18)
    + golongan : TinyInt
    + lokasi_sekolah : Enum
    + jabatan : String
    + tunjangan_jabatan : BigInt
    + jam_mengajar : Integer
    + potongan : BigInt
    --
    + kalkulasiGajiBulanan() : Double
    + getSlipGaji(bulan) : View
}

class SettingGajiGuru <<Entity>> {
    + id : Integer
    + golongan : TinyInt
    + gaji_pokok : Integer
    + transport : Integer
    + simpanan_koperasi : Integer
    + dana_sosial : Integer
    --
    + getTarifByGolongan(gol) : SettingGajiGuru
    + updateTarif(dataTarif) : Boolean
}

class Pengabdian <<Entity>> {
    + id : Integer
    + nama : String
    + lokasi : String
    + tunjangan_jabatan : BigInt
    + tunjangan_pengabdian : BigInt
    + tunjangan_lainnya : BigInt
    + honorarium_wkt : BigInt
    + honorarium_stn : BigInt
    + kehadiran_wkt : BigInt
    + kehadiran_stn : BigInt
    + potongan_dansos : BigInt
    + potongan_fpmk : BigInt
    + potongan_lainnya : BigInt
    --
    + hitungTotalTunjangan() : Double
    + hitungTotalPotongan() : Double
}

class JurnalMengajar <<Entity>> {
    + id : BigInteger
    + nik : String
    + kode_kelas : String
    + tanggal : Date
    + nama_mapel : String
    + materi : Text
    --
    + getLaporanJurnal() : Collection
}

' === RELASI BOUNDARY → CONTROLLER ===
HalamanLoginStaff ..> AuthController : <<uses>>

' === RELASI CONTROLLER → MODEL ===
AuthController ..> Admins : <<autentikasi>>
DashboardController ..> Presensi : <<statistik>>

LaporanPresensiController ..> Presensi : <<mengolah laporan>>
LaporanPresensiController ..> Karyawan : <<filter guru>>
LaporanPresensiController ..> JurnalMengajar : <<laporan jurnal>>

PayrollController ..> Guru : <<kelola data guru>>
PayrollController ..> SettingGajiGuru : <<mengatur tarif>>
PayrollController ..> Presensi : <<rekap kehadiran>>

PengabdianController ..> Pengabdian : <<kelola pengabdian>>

' === RELASI ANTAR ENTITY ===
Admins "1" ..> "0..*" Presensi : mencetak rekap >
Admins "1" ..> "0..*" Guru : mengelola penggajian >

Karyawan "1" -- "0..*" Presensi : memiliki histori >
Karyawan "1" -- "0..1" Guru : data gaji guru >

SettingGajiGuru "1" -- "0..*" Guru : acuan tarif gaji >

' === LAYOUT HINTS ===
HalamanLoginStaff -[hidden]right- AuthController
AuthController -[hidden]right- DashboardController

LaporanPresensiController -[hidden]right- PayrollController
PayrollController -[hidden]right- PengabdianController

@enduml
