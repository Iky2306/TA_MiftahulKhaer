@startuml Sequence_Staff_Setting_Gaji
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam sequence {
    ArrowColor #2980B9
    ActorBorderColor #1B4F72
    LifeLineBorderColor #2980B9
    LifeLineBackgroundColor #EBF5FB
    ParticipantBorderColor #1B4F72
    ParticipantBackgroundColor #EBF5FB
    ParticipantFontColor #1B2631
    GroupBorderColor #B7950B
    GroupBackgroundColor #FEF9E7
}

actor "Staff" as Staff
boundary "Halaman Setting Gaji\n(payroll/guru/setinggaji.blade.php)" as View
control "PayrollController" as Ctrl
entity "Model SettingGaji\n(setting_gaji_guru)" as Model

title **SEQUENCE DIAGRAM - SETTING GAJI GURU (ROLE STAFF)**

activate Staff
Staff -> View : 1: Pilih menu "Setting Gaji Guru"
activate View
View -> Ctrl : 2: setingGajiGuru()
activate Ctrl

Ctrl -> Model : 3: Ambil data konfigurasi tarif gaji per golongan
activate Model
Model --> Ctrl : 4: Return data tarif per golongan
deactivate Model

Ctrl --> View : 5: Return view setting gaji
deactivate Ctrl
View --> Staff : 6: Tampilkan formulir setting gaji (Golongan, Gaji Pokok, Transport, Simpanan, Dana Sosial)

Staff -> View : 7: Input / perbarui nominal komponen gaji per golongan
Staff -> View : 8: Klik tombol "Simpan Pengaturan"
View -> Ctrl : 9: simpanSetingGajiGuru(request)
activate Ctrl

Ctrl -> Ctrl : 10: Validasi kelengkapan format input nominal

alt #FDEDEC Tidak (Format Input Tidak Valid)
    Ctrl --> View : 11: Kirim pesan validasi kesalahan input
    View --> Staff : 12: Tampilkan pesan error validasi form
else #EAFAF1 Ya (Format Input Valid)
    Ctrl -> Model : 13: Simpan / perbarui tarif gaji ke tabel setting_gaji_guru
    activate Model
    Model --> Ctrl : 14: Return status sukses simpan
    deactivate Model

    Ctrl --> View : 15: Redirect::back()->with('success')
    deactivate Ctrl
    View --> Staff : 16: Tampilkan notifikasi "Pengaturan Gaji Berhasil Disimpan"
end

deactivate View
deactivate Staff
@enduml
