@startuml Sequence_Admin_Kelola_Data_Guru
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam sequence {
    ArrowColor #2980B9
    ActorBorderColor #1B4F72
    LifeLineBorderColor #2980B9
    LifeLineBackgroundColor #EBF5FB
    ParticipantBorderColor #1B4F72
    ParticipantBackgroundColor #EBF5FB
    ParticipantFontColor #1B2631
    GroupBorderColor #B7950B
    GroupBackgroundColor #FEF9E7
}

actor "Administrator" as Admin
boundary "Halaman Kelola Data Guru\n(karyawan/index.blade.php)" as View
control "KaryawanController" as Ctrl
entity "Model Karyawan\n(karyawan)" as Model

title **SEQUENCE DIAGRAM - KELOLA DATA GURU ADMIN**

activate Admin
Admin -> View : 1: Akses Menu Kelola Data Guru (/karyawan)
activate View
View -> Ctrl : 2: index()
activate Ctrl

Ctrl -> Model : 3: Ambil daftar karyawan/guru
activate Model
Model --> Ctrl : 4: Return list data karyawan
deactivate Model

Ctrl --> View : 5: Return view karyawan/index
deactivate Ctrl
View --> Admin : 6: Tampilkan tabel guru

Admin -> View : 7: Klik "Tambah Guru"
View --> Admin : 8: Tampilkan modal form tambah data guru

Admin -> View : 9: Input Username, Nama, Mapel, Jabatan, No Hp
Admin -> View : 10: Klik tombol "Simpan"
View -> Ctrl : 11: store(request)
activate Ctrl

Ctrl -> Ctrl : 12: Validasi Form dan kelengkapan data

alt #FDEDEC Tidak (Validasi Form Gagal / NIK Duplikat)
    Ctrl --> View : 13: Return peringatan gagal validasi
    View --> Admin : 14: Tampilkan pesan error & kembali ke form input
else #EAFAF1 Ya (Form Valid & Lengkap)
    Ctrl -> Model : 15: Simpan Data Guru dan Default Password (Hash::make('12345'))
    activate Model
    Model --> Ctrl : 16: Return status sukses simpan data
    deactivate Model

    Ctrl --> View : 17: Redirect::back()->with('success')
    deactivate Ctrl
    View --> Admin : 18: Tampilkan Pesan "Data Guru Berhasil Disimpan"
end

deactivate View
deactivate Admin
@enduml
