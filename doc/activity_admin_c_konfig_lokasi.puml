@startuml Activity_Admin_Lokasi_Sekolah
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam activity {
    BackgroundColor #FEF9E7
    BorderColor #000000
    FontColor #000000
    FontSize 11
}

skinparam diamond {
    BackgroundColor #D5E8D4
    BorderColor #000000
    FontColor #000000
    FontSize 10
}

|Administrator|
start
:Akses Menu Lokasi\nSekolah;
:Set Poin Koordinat GPS "Nama\nLokasi, Kode Lokasi, Latitude,\nLongtitude, Radius";

|Sistem|
:Validasi Ttitik\nGeofencing dan\nSimpan;

|Administrator|
:Tampilkan Pesan\nBerhasil;
stop
@enduml
