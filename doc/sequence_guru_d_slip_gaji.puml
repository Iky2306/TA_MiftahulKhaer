@startuml Sequence_Guru_Slip_Gaji
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam sequence {
    ArrowColor #2980B9
    ActorBorderColor #1B4F72
    LifeLineBorderColor #2980B9
    LifeLineBackgroundColor #EBF5FB
    ParticipantBorderColor #1B4F72
    ParticipantBackgroundColor #EBF5FB
    ParticipantFontColor #1B2631
    GroupBorderColor #B7950B
    GroupBackgroundColor #FEF9E7
}

actor "Guru" as Guru
boundary "Halaman Slip Gaji\n(payroll/slip_gaji.blade.php)" as View
control "PayrollController" as Ctrl
entity "Model Payroll\n(guru, setting_gaji_guru)" as Model
control "PDFGenerator\n(DomPDF)" as PDF

title **SEQUENCE DIAGRAM - MELIHAT SLIP GAJI DAN DOWNLOAD PDF**

activate Guru
Guru -> View : 1: Pilih menu "Slip Gaji"
activate View
View --> Guru : 2: Tampilkan pilihan periode bulan dan tahun

Guru -> View : 3: Pilih periode bulan dan tahun, klik "Cari"
View -> Ctrl : 4: getSlipGaji(bulan, tahun)
activate Ctrl

Ctrl -> Model : 5: Ambil data payroll guru
activate Model
Model --> Ctrl : 6: Return data payroll & setting gaji
deactivate Model

Ctrl -> Ctrl : 7: Hitung total dan jam mengajar pada bulan terpilih
Ctrl -> Ctrl : 8: Kalkulasi komponen gaji
Ctrl -> Ctrl : 9: Hitung total gaji
Ctrl --> View : 10: Return view rincian slip gaji
deactivate Ctrl
View --> Guru : 11: Tampilkan rincian slip gaji

alt #EAFAF1 ya (Download PDF)
    Guru -> View : 12: Klik tombol "Download PDF"
    View -> Ctrl : 13: downloadSlipGaji(bulan, tahun)
    activate Ctrl

    Ctrl -> PDF : 14: Generate dokumen PDF slip gaji
    activate PDF
    PDF --> Ctrl : 15: Return berkas PDF
    deactivate PDF

    Ctrl --> View : 16: Kirim file PDF
    deactivate Ctrl
    View --> Guru : 17: Unduh dan simpan file PDF
else #FDEDEC tidak (Selesai Melihat)
    Guru -> View : 18: Selesai melihat rincian gaji
end

deactivate View
deactivate Guru
@enduml
