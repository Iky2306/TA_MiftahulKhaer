@startuml Activity_Guru_Histori_Jurnal
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam activity {
    BackgroundColor #EBF5FB
    BorderColor #2980B9
    FontColor #1B2631
    FontSize 11
}

skinparam diamond {
    BackgroundColor #FEF9E7
    BorderColor #B7950B
    FontColor #7D6608
    FontSize 10
}

|Guru|
start
:Pilih menu "E-Jurnal";
:Pilih periode tanggal dan sampai;
:Klik tombol cari;

|Sistem|
:Ambil data jurnal mengajar guru;

|Guru|
:Tampilkan daftar riwayat jurnal;
if (Download PDF?) then (Ya)
    :Klik tombol "Download PDF";
    |Sistem|
    :Generate dokumen PDF riwayat e-jurnal;
    :Kirim file PDF;
    |Guru|
    :Unduh dan simpan file PDF;
    stop
else (Tidak)
    |Guru|
    :Selesai melihat riwayat e-jurnal;
    stop
endif
@enduml
