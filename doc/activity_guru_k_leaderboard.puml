@startuml Activity_Guru_Leaderboard
!theme plain
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11

skinparam activity {
    BackgroundColor #EBF5FB
    BorderColor #2980B9
    FontColor #1B2631
    FontSize 11
}

|Guru|
start
:Buka dashboard / halaman utama;

|Sistem|
:Ambil seluruh data transaksi guru "presensi, e-jurnal";
:Kalkulasi akumulasi perhitungan poin;
:Urutkan data guru berdasarkan skor tertinggi;
:Identifikasi posisi peringkat dan badge;

|Guru|
:Tampilkan papan peringkat "Leaderboard / Top Score";
:Tampilkan card posisi ranking dan detail perolehan poin;
:Selesai melihat peringkat dan skor;
stop
@enduml
